[Unit]
Description=OpenProxy 4G/5G Mobile Proxy Controller
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/openproxy
Environment=PYTHONPATH=/opt/openproxy
Environment=PATH=/opt/openproxy/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/opt/openproxy/venv/bin/uvicorn api.main:app --host 0.0.0.0 --port 8080
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
